# Google Play Developer API credentials
# A Google Cloud service account key (JSON) whose client_email has been invited
# in Play Console → Users and permissions.
# See docs/SETUP.md for the full walkthrough.

# Provide the service account key ONE of these three ways:

# 1) Absolute path to the downloaded .json key file (simplest)
GOOGLE_SERVICE_ACCOUNT_JSON=/absolute/path/to/service-account.json

# 2) ...or the raw JSON contents in the same variable (it is treated as inline
#    JSON when the value starts with "{")
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..."}

# 3) ...or base64 of the .json file (no quoting headaches):  base64 -i service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Fallback: Google's standard variable is also honoured if none of the above is set.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Optional safe-mode guardrails (enforced by the server, not just the agent):
# PLAY_MCP_READ_ONLY=true                          # block ALL writes
# PLAY_MCP_ALLOW_PRODUCTION_RELEASE=false          # block production releases + rollout % changes
# PLAY_MCP_ALLOW_PRICE_CHANGES=false               # block price changes / price migrations
# PLAY_MCP_ALLOW_REVIEW_REPLIES=false              # block public review replies
# PLAY_MCP_ALLOW_SUBSCRIPTION_ACTIVATION=false     # block (de)activating base plans and offers

# Optional: where listing snapshots are written (default ~/.googleplay-api-mcp/snapshots)
# PLAY_MCP_SNAPSHOT_DIR=
# Optional: auto-snapshot an app's listing text before the first listing edit (a safety net for "revert")
# PLAY_MCP_AUTO_SNAPSHOT=true
# Optional: regions version used for subscription pricing calls (default 2022/02)
# PLAY_MCP_REGIONS_VERSION=
